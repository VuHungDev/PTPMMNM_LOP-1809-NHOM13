# Mẫu biến môi trường — khi chưa có .env có thể copy file này.
# Nếu đã có .env, chỉ bổ sung biến còn thiếu; không ghi đè key đang dùng.
# File .env KHÔNG được commit lên git (đã có trong .gitignore).
# Gửi OTP cần cài PHPMailer bằng Composer; MAIL_PASSWORD thường là mật khẩu ứng dụng.
# MAIL_ENCRYPTION=tls với cổng 587, hoặc ssl với cổng 465 (theo nhà cung cấp).
# OTP_HASH_KEY: chuỗi bí mật ngẫu nhiên ít nhất 32 ký tự; không dùng chung với mật khẩu email.
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
# 0 = không giới hạn thời gian chờ AI; số dương (5–180) bật lại giới hạn mỗi lượt.
# Mặc định chờ đến khi AI trả kết quả hoặc kết nối/dịch vụ báo lỗi.
AI_TIMEOUT=0
# Chỉ dùng hai biến sau nếu AI_PROVIDER=openai (cổng tương thích Chat Completions).
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# Kết nối XAMPP/MariaDB bằng PDO mysql, không phải SQL Server.
# Chỉ điền port sau khi xác minh database: launcher dự án dùng 3307/data3307;
AJ_DB_HOST=127.0.0.1
AJ_DB_PORT=
AJ_DB_NAME=algojudge
AJ_DB_USER=root
AJ_DB_PASS=

# Gmail SMTP: tài khoản bật xác minh 2 bước và cho phép mật khẩu ứng dụng.
# Điền MAIL_USERNAME và MAIL_FROM_ADDRESS bằng cùng tài khoản Gmail của bạn.
# MAIL_MAILER chỉ mô tả cấu hình; Mailer hiện dùng SMTP cố định.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=AlgoJudge
OTP_HASH_KEY=

# Không đặt chú thích cuối dòng giá trị; loader chỉ hỗ trợ chú thích trên dòng riêng.
# Biến môi trường của tiến trình được ưu tiên hơn các giá trị trong .env.
